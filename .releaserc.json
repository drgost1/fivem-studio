{
  "branches": ["main"],
  "tagFormat": "v${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/package-release.mjs ${nextRelease.version}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "release/Ghz-Workbench-Setup-*.exe",
            "label": "Ghz Workbench Windows installer"
          },
          {
            "path": "release/SHA256SUMS.txt",
            "label": "SHA-256 checksums"
          },
          {
            "path": "release/bom.cdx.json",
            "label": "CycloneDX SBOM"
          }
        ],
        "successComment": false,
        "failComment": false
      }
    ]
  ]
}
