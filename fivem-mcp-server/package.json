{
  "name": "@tufanstudio/fivem-studio-runtime",
  "version": "0.0.0-development",
  "description": "Private loopback runtime for FiveM Studio console logs and resource reloads.",
  "author": "Tufan Studio",
  "license": "MIT",
  "repository": "https://github.com/drgost1/fivem-studio",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "fivem-studio-runtime": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run build && esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=bundle/runtime.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "24.20.0"
  }
}
