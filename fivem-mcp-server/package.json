{
  "name": "@ghzgarage/workbench-runtime",
  "version": "0.0.0-development",
  "description": "Private loopback runtime for Ghz Workbench console logs and resource reloads.",
  "author": "GhzGarage",
  "license": "MIT",
  "repository": "https://github.com/GhzGarage/GhzWorkbench",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ghz-workbench-runtime": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "npm run build && esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=bundle/runtime.cjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.4.5",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
